# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Deployment
/code/

# Raw gallery originals (staging); keep folder structure and README
/gallery-incoming/**
!/gallery-incoming/README.md
!/gallery-incoming/*/
!/gallery-incoming/*/.gitkeep

# Raw reel originals (staging); keep README and manifest
/reels-incoming/*
!/reels-incoming/README.md
!/reels-incoming/reels.json

